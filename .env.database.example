# Copy to an ignored local .env. Never put these values in VITE_*.
DATA_BACKEND=postgres
# adopted: owner-supplied catalog_* / user_profiles schema. prototype: local historical fixtures only.
DATABASE_SCHEMA=adopted
DATABASE_ENV=development
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:54322/postgres
DATABASE_SSL=disable
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=LOCAL_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_LOCAL_SERVICE_ROLE_KEY
# Enable only after a real provider delivery test in Supabase Auth.
SUPABASE_SMS_READY=false
PORTAL_SESSION_SECRET=GENERATE_A_RANDOM_SERVER_SECRET
# Optional reviewed live exports. Sources remain unchanged.
# IMPORT_PORTAL_PATH=/private/backup/portal.json
# IMPORT_OVERRIDES_PATH=/private/backup/catalog-overrides.json
# IMPORT_BROWSER_EXPORT_PATH=/private/backup/browser-export.json
# Production-only gates; fill only after owner approval and restore verification.
# PRODUCTION_MIGRATION_APPROVED=yes
# REVIEWED_PLAN_SHA256=
# VERIFIED_BACKUP_PATH=/private/backup/postgres.dump
# VERIFIED_BACKUP_SHA256=
