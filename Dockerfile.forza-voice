# Dedicated FORZA Pocket TTS container. No Node, Vite, catalog or database.
# Use this Dockerfile ONLY for the private forza-voice Railway service.
FROM python:3.11-slim-bookworm
WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    ONNXRUNTIME_LOG_SEVERITY_LEVEL=3 \
    HF_HUB_DOWNLOAD_TIMEOUT=240 \
    HF_HUB_ETAG_TIMEOUT=90
RUN apt-get update \
 && apt-get install -y --no-install-recommends git curl ca-certificates libsndfile1 \
 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir onnxruntime numpy scipy soundfile sentencepiece typer "huggingface_hub[cli]"
RUN mkdir -p vendor/persian_tts \
 && git init vendor/persian_tts \
 && git -C vendor/persian_tts remote add origin https://github.com/nimaone/persian_tts.git \
 && git -C vendor/persian_tts fetch --depth 1 origin e834bd65ac622f376c4d2050821decf5eb95241c \
 && git -C vendor/persian_tts checkout --detach FETCH_HEAD
RUN python - <<'PY'
from pathlib import Path
p = Path('vendor/persian_tts/scripts/tts_onnx.py')
s = p.read_text()
old = 'opts.intra_op_num_threads = 2'
assert old in s
s = s.replace(old, 'opts.intra_op_num_threads = int(os.environ.get("FORZA_CPU_INTRA", "1"))\n        opts.enable_cpu_mem_arena = os.environ.get("FORZA_CPU_ARENA", "0") == "1"\n        opts.enable_mem_pattern = os.environ.get("FORZA_CPU_PATTERN", "0") == "1"')
old = 'self.s_enc = ort.InferenceSession(str(self.dir / "mimi_encoder.onnx"), opts, providers=prov)'
assert old in s
s = s.replace(old, 'self.s_enc = None if os.environ.get("FORZA_POCKET_PRECOMPUTED_VOICE") == "1" else ort.InferenceSession(str(self.dir / "mimi_encoder.onnx"), opts, providers=prov)')
# Optional, tested-only INT8 flow graph. Original FP32 is the default.
old = 'str(self.dir / "flow_lm_step.onnx")'
assert s.count(old) == 1
s = s.replace(old, 'str(self.dir / ("flow_lm_step.int8.onnx" if os.environ.get("FORZA_ONNX_INT8") == "1" else "flow_lm_step.onnx"))')
p.write_text(s)
p = Path('vendor/persian_tts/scripts/g2p_onnx.py')
s = p.read_text()
old = 'opts = ort.SessionOptions()'
assert old in s
s = s.replace(old, old + '\n        opts.intra_op_num_threads = 1\n        opts.inter_op_num_threads = 1\n        opts.enable_cpu_mem_arena = False\n        opts.enable_mem_pattern = False')
p.write_text(s)
PY
COPY scripts/forza_pocket_worker.py scripts/forza_pocket_worker.py
COPY scripts/forza_voice_http.py scripts/forza_voice_http.py
RUN mkdir -p public vendor/persian_tts/model/v2 \
 && hf download Nimaone/pocket-tts-farsi-v2-onnx --local-dir /app/vendor/persian_tts/model/onnx \
 && curl -fL --retry 3 --connect-timeout 30 https://huggingface.co/mehdi-hf/pocket-tts-farsi-v2/resolve/main/tokenizer_ph.model -o vendor/persian_tts/model/v2/tokenizer_ph.model \
 && curl -fL --retry 3 --connect-timeout 30 https://huggingface.co/mehdi-hf/pocket-tts-farsi-v2/resolve/main/normalize_fa.py -o vendor/persian_tts/model/v2/normalize_fa.py \
 && curl -fL --retry 3 --connect-timeout 30 https://huggingface.co/mehdi-hf/pocket-tts-farsi-v2/resolve/main/samples/hello.wav -o /tmp/forza-selected-hello.wav \
 && python -c "import soundfile as sf; a,sr=sf.read('/tmp/forza-selected-hello.wav'); assert sr==24000 and len(a)/sr>=4; sf.write('public/forza-pocket-reference.wav',a[:5*sr],sr,subtype='PCM_16')" \
 && python scripts/forza_pocket_worker.py --greeting \
 && test -s public/forza-greeting-bootstrap.wav \
 && rm -rf /root/.cache/huggingface /tmp/forza-selected-hello.wav vendor/persian_tts/.git
EXPOSE 8080
CMD ["python", "-u", "scripts/forza_voice_http.py"]
