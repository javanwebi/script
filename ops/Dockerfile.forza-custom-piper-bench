# Benchmark-only runner for a PRIVATE custom Piper ONNX voice.
# No model/dataset is ever copied into this Docker image.
FROM python:3.11-slim-bookworm
ENV PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
RUN python -m pip install --no-cache-dir piper-tts==1.8.0
WORKDIR /probe
