FROM node:22-bookworm

# The production website runs from node:22-bookworm directly, not the
# repository's full Railway Dockerfile. Keep this runtime small and install
# only the private server-side Persian STT dependencies.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    ca-certificates curl ffmpeg libgomp1 python3 python3-venv \
 && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/forza-pocket \
 && /opt/forza-pocket/bin/pip install --no-cache-dir --upgrade pip \
 && /opt/forza-pocket/bin/pip install --no-cache-dir vosk==0.3.45

# Pin the exact Diba Persian small-model revision; model weights remain inside
# this private runtime image and never reach the browser.
RUN mkdir -p /opt/diba-stt \
 && curl -fL --retry 3 --connect-timeout 30 \
    https://huggingface.co/Dibachain/Diba-STT/resolve/c244182debe853f83a00a03642830e7507a55d1d/browser/diba-stt-fa-small.tar.gz \
    -o /tmp/diba-stt-fa-small.tar.gz \
 && tar -xzf /tmp/diba-stt-fa-small.tar.gz -C /opt/diba-stt \
 && MODEL_ROOT="$(find /opt/diba-stt -type d -name am -printf '%h\\n' | head -n 1)" \
 && test -n "$MODEL_ROOT" \
 && ln -s "$MODEL_ROOT" /opt/diba-stt/model \
 && test -d /opt/diba-stt/model/conf \
 && rm -f /tmp/diba-stt-fa-small.tar.gz

ENV FORZA_STT_PROVIDER=diba \
    FORZA_STT_DIBA_MODEL_PATH=/opt/diba-stt/model \
    FORZA_STT_PYTHON=/opt/forza-pocket/bin/python \
    FORZA_STT_WORKERS=2
