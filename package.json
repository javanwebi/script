{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "optimize:images": "node scripts/optimize-images.mjs",
    "predev": "node scripts/optimize-images.mjs",
    "dev": "node --import tsx server.ts",
    "prebuild": "node scripts/optimize-images.mjs",
    "build": "vite build",
    "start": "node --import tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "cap:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "apk:release": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "test:portal": "node --import tsx --test tests/portal*.test.ts",
    "db:plan": "node --import tsx scripts/database/migrate.ts plan",
    "db:migrate": "node --import tsx scripts/database/migrate.ts apply",
    "db:import": "node --import tsx scripts/database/migrate.ts import",
    "db:backup": "node --import tsx scripts/database/backup.ts",
    "db:dev": "node --import tsx scripts/database/dev.ts",
    "db:auth:dev": "node --import tsx scripts/database/provisionAuth.ts",
    "test:database": "node --import tsx --test tests/database/*.test.ts",
    "db:bundle:adopted": "node --import tsx scripts/database/bundleAdopted.ts",
    "db:verify:adopted": "node --import tsx scripts/database/verifyAdopted.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "msedge-tts": "^2.0.8",
    "pg": "8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.4",
    "three": "^0.186.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "ws": "^8.22.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@electric-sql/pglite": "0.5.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.27.0",
    "supabase": "2.121.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
