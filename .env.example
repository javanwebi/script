# Server-only shared Gemini key. Both image recognition and FORZA consultation use this key.
# Never put real API keys in GitHub or Vite public environment variables.
GEMINI_API_KEY=""

# Site origin used for image uploads and API routing.
APP_URL=""

# Private self-hosted Mana Persian Piper (MIT voice, GPLv3 Piper engine).
# Add a separate Railway service from services/forza-tts; never expose it publicly.
FORZA_TTS_BASE_URL=""
FORZA_TTS_PROTOCOL="openai"
FORZA_TTS_MODEL="mana-piper-fa"
FORZA_TTS_VOICE="mana-fa-ir"
FORZA_TTS_TOKEN=""
FORZA_TTS_TIMEOUT_MS="12000"

# Optional publicly accessible image origin; empty derives from APP_URL.
VISION_IMAGE_PUBLIC_ORIGIN=""
