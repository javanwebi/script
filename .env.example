# Server-only shared Gemini key. Both image recognition and FORZA consultation use this key.
# Never put real API keys in GitHub or Vite public environment variables.
GEMINI_API_KEY=""

# Site origin used for image uploads and API routing.
APP_URL=""

# Optional dedicated Persian speech service, not a Cloudflare Worker.
# Run behind Railway private networking or a protected HTTPS origin.
FORZA_TTS_BASE_URL=""
# For GPU-hosted MOSS set "moss-realtime" for native /tts/session/* streaming API.\n# Older pocket gateways support "parsigo" and "openai".\n# MOSS endpoint must be HTTPS and protected by FORZA_TTS_TOKEN.
FORZA_TTS_PROTOCOL="parsigo"
FORZA_TTS_MODEL="pocket-tts-farsi-v2"
FORZA_TTS_VOICE="male_hello.wav"
FORZA_TTS_TOKEN=""
# Use a licensed/consented adult male Persian reference audio mounted on GPU host.
MOSS_TTS_PROMPT_AUDIO="/app/voices/forza_male_fa.wav"
# GPU inference can take longer than small Piper-style models.
FORZA_TTS_TIMEOUT_MS="20000"
# MOSS_TTS_MODEL example: FORZA_TTS_MODEL="moss-tts-realtime"
# MOSS native adapter requires FORZA_TTS_PROTOCOL="moss-realtime"

# Optional publicly accessible image origin; empty derives from APP_URL.
VISION_IMAGE_PUBLIC_ORIGIN=""
