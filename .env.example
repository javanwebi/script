# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ATLAS_AI_WORKER_URL: Cloudflare Worker providing Gemini AI for Forza calls & AI consultations
ATLAS_AI_WORKER_URL="https://atlasai.javanwebio.workers.dev"

# Visual part identification: Worker first. Set explicitly to "" to disable.
PART_RECOGNITION_WORKER_URL="https://atlas-aishenasaei.javanwebio.workers.dev/"
# Must match the Worker's access token (not its Gemini provider key).
PART_RECOGNITION_WORKER_TOKEN=""
PART_RECOGNITION_WORKER_TIMEOUT_MS="45000"
# Direct Gemini provider key when Worker is disabled/unavailable. Server only.
ai-forza=""
# Shell-friendly alias, used when ai-forza is empty:
AI_FORZA_API_KEY=""

# Optional: public HTTPS backend origin serving /imageai (not a static frontend URL).
# Leave empty to derive from APP_URL / request proxy headers.
VISION_IMAGE_PUBLIC_ORIGIN=""
