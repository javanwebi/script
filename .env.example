# Server-only shared Gemini key. Both image recognition and FORZA consultation use this key.
# Never put real API keys in GitHub or Vite public environment variables.
GEMINI_API_KEY=""

# Site origin used for image uploads and API routing.
APP_URL=""

# Optional publicly accessible image origin; empty derives from APP_URL.
VISION_IMAGE_PUBLIC_ORIGIN=""

# Optional xKiro OpenAI-compatible provider for FORZA consultation (server only).
# Free models have a daily allowance; use a vendor-qualified :free model ID.
# Never commit a real key or expose it through VITE_ variables.
# FORZA speech recognition (STT) is independent from xKiro chat and Nima TTS.
# Production Docker images bundle the offline Persian Diba/Vosk small model.
# It is the server-side final recognizer; browser interim text remains visible
# immediately while the final utterance is confirmed by the server.
FORZA_STT_PROVIDER="diba"
FORZA_STT_DIBA_MODEL_PATH="/opt/diba-stt/model"
FORZA_STT_WORKERS="2"
# Optional legacy Gemini STT, only when explicitly selected:
# FORZA_STT_PROVIDER="gemini"
# FORZA_STT_GEMINI_API_KEY=""
# FORZA_STT_GEMINI_MODEL="gemini-3.1-flash-lite"
XKIRO_API_KEY=""
XKIRO_MODEL_DESK="qwen/qwen3.5-flash:free"
XKIRO_MODEL_VOICE="qwen/qwen3.5-flash:free"

# AvalAI OpenAI-compatible text model provider for FORZA chat and voice.
# Keep this key server-side only; never use a VITE_ prefix or commit a real key.
AVALAI_API_KEY=""
AVALAI_MODEL_DESK="glm-5.3-flash"
AVALAI_MODEL_VOICE="glm-5.3-flash"
# Select AvalAI independently for each surface after adding the key:
# FORZA_DESK_PROVIDER="avalai"
# FORZA_VOICE_PROVIDER="avalai"

# Optional B.AI text provider for FORZA consultation (server only).
# Current free/discount offers change; check https://docs.b.ai/llmservice/promotions-and-pricing-notices/
# Set BAI_API_KEY in Railway Variables, NEVER in VITE_ variables or Git.
BAI_API_KEY=""
# Set to bai to enable B.AI for desk replies; leave gemini for existing behavior.
FORZA_DESK_PROVIDER="gemini"
# Voice stays on the existing Gemini path unless separately tested and enabled.
FORZA_VOICE_PROVIDER="gemini"
# Models must be available to your B.AI account; these are NOT permanently free.
BAI_MODEL_DESK="qwen3.7-flash"
BAI_MODEL_VOICE="qwen3.7-flash"
